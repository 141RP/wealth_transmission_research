# ---- Project data ----
# Raw and intermediate scraped data never goes in git.
data/raw/
data/interim/
data/cache/
data/**/*.html
data/**/*.csv
# Masked samples are the only data that may be committed.
!data/sample/*_masked.csv

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers and linters
.mypy_cache/
.ruff_cache/
.pyre/

# Jupyter
.ipynb_checkpoints/

# ---- Editors and OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Secrets and local settings ----
.env
.env.*
!.env.example
